# -----------------------------------------------------
# INIT
# -----------------------------------------------------

# Only run for interactive shells
[[ $- != *i* ]] && return

# -----------------------------------------------------
# PATH
# -----------------------------------------------------
path_prepend() {
    case ":$PATH:" in
        *":$1:"*) ;;
        *) PATH="$1:$PATH" ;;
    esac
}

path_prepend "$HOME/.local/bin"
path_prepend "$HOME/.cargo/bin"
path_prepend "$HOME/.local/share/bob/nvim-bin"

export PATH

# -----------------------------------------------------
# Editor / Defaults
# -----------------------------------------------------
export EDITOR="nvim"
export VISUAL="$EDITOR"
export SUDO_EDITOR="$EDITOR"
export PAGER="less"

# Optional Neovim profile
# export NVIM_APPNAME="nvim-nvchad"
# export NVIM_APPNAME="nvim-astro6"

# -----------------------------------------------------
# Database Context - PostgreSQL / PostGIS
# -----------------------------------------------------
export PGHOST="localhost"
export PGPORT="5432"
export PGDATABASE="postgis"
export PGUSER="postgres"
export PGPASSFILE="$HOME/.pgpass"
export PSQL_PAGER="pspg"

# Default Docker container for PostGIS
export PG_CONTAINER="postgis-db"
